[Unit]
Description=KINGPRO Qwen3.5-9B inference (loopback only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/kingpro
Environment=HF_HOME=/opt/kingpro/cache
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=VLLM_NO_USAGE_STATS=1
Environment=LD_LIBRARY_PATH=/usr/local/cuda-12.8/compat
Environment=PATH=/opt/kingpro/venv/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/kingpro/venv/bin/vllm serve Qwen/Qwen3.5-9B --revision c202236235762e1c871ad0ccb60c8ee5ba337b9a --host 127.0.0.1 --port 8000 --max-model-len 32768 --max-num-seqs 4 --gpu-memory-utilization 0.8 --reasoning-parser qwen3
Restart=on-failure
RestartSec=20
TimeoutStartSec=1800
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
